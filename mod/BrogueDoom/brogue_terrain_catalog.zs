// Cosmetic explorer traces: inert, non-loot, and never synchronized as terrain.
class BrogueExplorerBedroll : BrogueTerrainStone { Default { Scale 1; } }
class BrogueExplorerBones : BrogueTerrainStone { Default { Scale 0.8; } }
class BrogueExplorerJunk : BrogueTerrainStone { Default { Scale 0.65; } }
class BrogueExplorerFallenTorch : BrogueTerrainStone { Default { Scale 0.85; } }
class BrogueExplorerSkins : BrogueTerrainStone { Default { Scale 0.7; } }
class BrogueExplorerRubble : BrogueTerrainStone { Default { Scale 0.55; } }
