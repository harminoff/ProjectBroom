// Project Broom presentation-only lights. Ambient lights deliberately opt out of
// shadow maps so the enhanced default remains inexpensive on large caverns.

flickerlight BROGUE_TORCH_LIGHT
{
 color 1.0 0.49 0.13
 size 64
 secondarySize 72
 chance 0.20
 attenuate 1
 noshadowmap 1
}
flickerlight BROGUE_HAUNTED_TORCH_LIGHT
{
 color 0.58 0.20 1.0
 size 54
 secondarySize 62
 chance 0.20
 attenuate 1
 noshadowmap 1
}
object BrogueTerrainTorchFlame { frame BRGDA { light BROGUE_TORCH_LIGHT } }
object BrogueTerrainHauntedTorchFlame { frame BRGDA { light BROGUE_HAUNTED_TORCH_LIGHT } }

material texture RRGCAVE { shader "shaders/search-reveal.fp" disablealphatest }
material texture RRGWET { shader "shaders/search-reveal.fp" disablealphatest }
material texture RRGMASON { shader "shaders/search-reveal.fp" disablealphatest }

material "graphics/BRGSEARCH.png"
{
    shader "shaders/search-reveal.fp"
    disablealphatest
}

flickerlight BROGUE_LAVA_LIGHT
{
	color 1.0 0.24 0.035
	size 78
	secondarySize 96
	chance 0.18
	attenuate 1
	noshadowmap 1
}

flickerlight BROGUE_FIRE_LIGHT
{
	color 1.0 0.50 0.10
	size 104
	secondarySize 132
	chance 0.28
	attenuate 1
	noshadowmap 1
}

pointlight BROGUE_IMPACT_LIGHT
{
	color 1.0 0.72 0.25
	size 52
	attenuate 1
	noshadowmap 1
}

object BrogueLavaFx
{
	frame TNT1A { light BROGUE_LAVA_LIGHT }
}

object BrogueFireFx
{
	frame TNT1A { light BROGUE_FIRE_LIGHT }
}

object BrogueImpactFx
{
	frame TNT1A { light BROGUE_IMPACT_LIGHT }
}

brightmap flat BRGMOLT
{
	map "graphics/BRGLAVA_BM.png"
}

brightmap texture BRGLFALL
{
	map "graphics/BRGLAVA_BM.png"
}

Glow
{
	Flats
	{
		BRGMOLT, FF3F08, 40
	}
}

material flat RRGEARTH { shader "shaders/search-floor-reveal.fp" disablealphatest }

material flat RRGMOSS { shader "shaders/search-floor-reveal.fp" disablealphatest }

material flat RRGFLAG { shader "shaders/search-floor-reveal.fp" disablealphatest }

material texture RRGCVUP { shader "shaders/search-reveal.fp" disablealphatest }

material texture RRGWTUP { shader "shaders/search-reveal.fp" disablealphatest }

material texture RRGMSUP { shader "shaders/search-reveal.fp" disablealphatest }

material flat RRGBRID { shader "shaders/search-floor-reveal.fp" disablealphatest }

material flat RRGWATR { shader "shaders/search-floor-reveal.fp" disablealphatest }

material flat RRGSLDG { shader "shaders/search-floor-reveal.fp" disablealphatest }

material flat RRGMOLT { shader "shaders/search-floor-reveal.fp" disablealphatest }

