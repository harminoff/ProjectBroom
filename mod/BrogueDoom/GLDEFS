// Project Broom presentation-only lights. Ambient lights deliberately opt out of
// shadow maps so the enhanced default remains inexpensive on large caverns.

flickerlight BROGUE_TORCH_LIGHT
{
 color 1.0 0.49 0.13
 size 64
 secondarySize 72
 chance 0.20
 attenuate 1
 noshadowmap 1
}
flickerlight BROGUE_HAUNTED_TORCH_LIGHT
{
 color 0.58 0.20 1.0
 size 54
 secondarySize 62
 chance 0.20
 attenuate 1
 noshadowmap 1
}
object BrogueTerrainTorchFlame { frame BRGDA { light BROGUE_TORCH_LIGHT } }
object BrogueTerrainHauntedTorchFlame { frame BRGDA { light BROGUE_HAUNTED_TORCH_LIGHT } }

pointlight BROGUE_SUNLIGHT
{
 color 0.55 0.44 0.28
 size 28
 attenuate 1
 noshadowmap 1
}
object BrogueTerrainSunRay { frame BRGDA { light BROGUE_SUNLIGHT } }

material texture RRGCAVE { shader "shaders/search-reveal.fp" disablealphatest }
material texture RRGWET { shader "shaders/search-reveal.fp" disablealphatest }
material texture RRGMASON { shader "shaders/search-reveal.fp" disablealphatest }

material "graphics/BRGSEARCH.png"
{
