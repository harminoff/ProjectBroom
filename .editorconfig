root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,h,hpp,cs,py}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{ps1,cmd,bat,sln,vcxproj,vcxproj.filters}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
